rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== MOBILE APP RULES =====
    
    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Itineraries subcollection - users can only access their own itineraries
      match /itineraries/{itineraryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Bucket list subcollection - users can only access their own bucket list items
      match /bucketList/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // NEW: Travel Posts for Social Feed
    match /travelPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Comments subcollection for Travel Posts
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
        
        // NEW: Nested Replies subcollection underneath each Comment
        match /replies/{replyId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null;
          allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
        }
      }
    }

    // NEW: Social Feed Stories
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Community posts - authenticated users can read all, write their own
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Comments - authenticated users can read all, write their own
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Reviews - public read, authenticated users can create, users can update/delete their own
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Byahe (short video feed) - public read, authenticated write
    match /byahe/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      // Byahe comments subcollection - public read, authenticated create, own update/delete
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }
    
    // ===== CMS ADMIN RULES =====
    
    // Island Groups - public read, admin write
    match /islandGroups/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Regions - public read, admin write
    match /regions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Provinces - public read, admin write
    match /provinces/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Municipalities - public read, admin write
    match /municipalities/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      // Activities subcollection - public read, admin write
      match /activities/{activityId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      // Rooms subcollection - public read, admin write
      match /rooms/{roomId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    
    // Popular Destinations (legacy) - public read, admin write
    match /popularDestinations/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Featured Attractions (new) - public read, admin write
    match /featuredAttractions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Featured Provinces (new) - public read, admin write
    match /featuredProvinces/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Top Experiences (new) - public read, admin write
    match /topExperiences/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Admin Profiles - only the owner can read/write their own profile
    match /adminProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
