rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users — auth read/write own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Itineraries — auth read/write own
      match /itineraries/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Bucket List — auth read/write own
      match /bucketList/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Posts — auth read all, write own
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Comments — auth read all, write own
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Reviews — public read, auth create, write own
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Geographic hierarchy — public read, auth write
    match /islandGroups/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /regions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /provinces/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /municipalities/{docId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /activities/{activityId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /rooms/{roomId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Featured content — public read, auth write
    match /popularDestinations/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /featuredAttractions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin profiles — auth read/write own
    match /adminProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
